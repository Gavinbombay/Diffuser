{
  "comment": "RTX 4060 8 GB laptop (A15, Ryzen 9). Polls every 3s. Drains the fleet the moment a watched game or a foreign GPU load appears, then waits 180s of continuous idle before starting the worker again. Replace controller_url with the fleet origin. Put the fleet admin bearer (the worker enroll_bearer) in token_file and chmod 600 that file.",
  "worker_id": "a15-rtx4060",
  "controller_url": "https://diffuser.invalid",
  "token_file": "example-admin-token.txt",
  "token_env": "EXAMPLE_DIFFUSER_ADMIN_TOKEN",
  "poll_interval_secs": 3,
  "idle_cooldown_secs": 180,
  "busy_util_pct": 25,
  "busy_vram_mib": 1500,
  "http_timeout_secs": 5,
  "nvidia_smi_timeout_secs": 2,
  "nvidia_smi_bin": "nvidia-smi",
  "process_watchlist": [
    "steam",
    "cs2",
    "cyberpunk",
    "eldenring",
    "baldursgate",
    "valorant",
    "helldivers",
    "gamescope",
    "wine64-preloader"
  ],
  "diffuser_process_markers": [
    "uai-diffuser",
    "diffuser",
    "fleet-worker"
  ],
  "gpu_process_ignore": [
    "xorg",
    "xwayland",
    "gnome-shell",
    "mutter",
    "kwin",
    "plasmashell",
    "sway",
    "hyprland",
    "dwm.exe",
    "explorer.exe",
    "csrss.exe",
    "sihost.exe",
    "shellexperiencehost.exe",
    "searchhost.exe",
    "startmenuexperiencehost.exe",
    "textinputhost.exe",
    "applicationframehost.exe",
    "systemsettings.exe",
    "nvcontainer",
    "nvidia-smi",
    "nvsphelper",
    "amdow",
    "radeonsoftware"
  ],
  "worker_command": [
    "/usr/local/bin/uai-diffuser",
    "--fleet-worker",
    "/home/operator/.config/diffuser/a15-worker.json"
  ],
  "worker_pid_file": "/home/operator/.local/state/diffuser/a15-fleet-worker.pid",
  "stop_timeout_secs": 10,
  "reenroll": null,
  "state_file": "/home/operator/.local/state/diffuser/gamer-idle-guard.json"
}
